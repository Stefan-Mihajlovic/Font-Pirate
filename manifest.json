{
  "manifest_version": 3,
  "name": "Font Pirate",
  "version": "2.1.0",
  "minimum_chrome_version": "116",
  "description": "Explore Google Fonts, identify type on websites, and save your font pairings.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Font Pirate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?surface=sidepanel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "host_permissions": [
    "https://tvm-licensing-api-prod.optiflowzoffice.workers.dev/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ]
}
